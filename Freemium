local function HandleUndergroundShift(state)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if state then hrp.CFrame = hrp.CFrame * CFrame.new(0, -15, 0)
        else hrp.CFrame = hrp.CFrame * CFrame.new(0, 15, 0) end
    end
end

