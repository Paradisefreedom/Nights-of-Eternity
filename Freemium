local bvName = "ShinyLeakMovement"

-- Keeps gravity disabled so CFrame movement is perfectly smooth
local function getOrMakeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = bvName
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) 
        bv.Velocity = Vector3.zero -- Zero velocity ensures gravity doesn't fight the CFrame
        bv.Parent = hrp
    end
    return bv
end

local function removeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if bv then bv:Destroy() end
end

-- Find any objective starting with "HitboxFollowModel"
local function getHitboxObjective()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name:sub(1, 17) == "HitboxFollowModel" then
            if obj:IsA("BasePart") then return obj end
            if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
            local part = obj:FindFirstChildWhichIsA("BasePart")
            if part then return part end
        end
    end
    return nil
end

-- 1. Noclip Logic
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hoverUnder = Toggles.HoverToggle.Value and Toggles.HoverUnderground.Value
        local glideUnder = Toggles.GlideToggle.Value and Toggles.GlideUnderground.Value
        local isFarming = Toggles.AutoFarmToggle.Value

        if hoverUnder or glideUnder or isFarming then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- 2. Movement & Farming Logic (Using CFrame)
RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not (hrp and hum) then return end

    -- Auto Farm Priority
    if Toggles.AutoFarmToggle.Value then
        local targetObj = getHitboxObjective()

        if targetObj then
            local bv = getOrMakeBV(hrp)
            bv.Velocity = Vector3.zero
            
            local targetPos = targetObj.Position
            local direction = (targetPos - hrp.Position).Unit
            local distance = (hrp.Position - targetPos).Magnitude
            
            if distance > 5 then
                -- Move directly via CFrame towards the objective
                hrp.CFrame = hrp.CFrame + (direction * (Options.FarmSpeed.Value * dt))
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            else
                local prompt = targetObj.Parent:FindFirstChildWhichIsA("ProximityPrompt", true) or targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then fireproximityprompt(prompt, 1, true) end
            end
        end
        return 
    end

    -- Manual Movement Logic (Strict CFrame)
    local hoverOn = Toggles.HoverToggle.Value
    local glideOn = Toggles.GlideToggle.Value

    if hoverOn then
        local bv = getOrMakeBV(hrp)
        bv.Velocity = Vector3.zero 
        
        -- CFrame movement based on Walk Direction
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Options.HoverSpeed.Value * dt))
        end
        
        if Toggles.HoverUnderground.Value then 
            hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z) 
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
    elseif glideOn then
        local bv = getOrMakeBV(hrp)
        bv.Velocity = Vector3.zero
        
        -- CFrame movement with slight Y drop (-3 * dt)
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Options.GlideSpeed.Value * dt))
        end
        hrp.CFrame = hrp.CFrame + Vector3.new(0, -3 * dt, 0)
        
        if Toggles.GlideUnderground.Value then 
            hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z) 
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
    else
        removeBV(hrp)
    end
end)

