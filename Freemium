local bvName = "ShinyLeakMovement"

local function getOrMakeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = bvName
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) 
        bv.Velocity = Vector3.zero 
        bv.Parent = hrp
    end
    return bv
end

local function removeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if bv then bv:Destroy() end
end

-- Smarter target finder (Finds the closest valid objective)
local function getNearestObjective(hrp)
    local targetName = Options.ObjectiveName.Value
    if targetName == "" then return nil end

    local closestPart = nil
    local shortestDistance = math.huge

    for _, obj in pairs(workspace:GetDescendants()) do
        if string.find(obj.Name, targetName) then
            local part = nil
            
            if obj:IsA("BasePart") then 
                part = obj 
            elseif obj:IsA("Model") then 
                part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            elseif obj:IsA("Folder") then
                part = obj:FindFirstChildWhichIsA("BasePart", true)
            end
            
            if part then
                -- Make sure it has an interact prompt nearby so we don't go to broken ones
                local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true) 
                            or (part.Parent and part.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                
                if prompt then
                    local distance = (hrp.Position - part.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPart = part
                    end
                end
            end
        end
    end
    return closestPart
end

-- 1. Noclip Logic
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hoverUnder = Toggles.HoverToggle.Value and Toggles.HoverUnderground.Value
        local glideUnder = Toggles.GlideToggle.Value and Toggles.GlideUnderground.Value
        local isFarming = Toggles.AutoFarmToggle.Value

        if hoverUnder or glideUnder or isFarming then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- 2. Movement & Farming Logic (Using CFrame)
RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not (hrp and hum) then return end

    -- Auto Farm Priority
    if Toggles.AutoFarmToggle.Value then
        local targetObj = getNearestObjective(hrp)

        if targetObj then
            local bv = getOrMakeBV(hrp)
            bv.Velocity = Vector3.zero
            
            local targetPos = targetObj.Position
            -- Hover slightly above to avoid clipping underground
            local hoverPos = targetPos + Vector3.new(0, 3, 0)
            local direction = (hoverPos - hrp.Position).Unit
            local distance = (hrp.Position - hoverPos).Magnitude
            
            if distance > 4 then
                hrp.CFrame = hrp.CFrame + (direction * (Options.FarmSpeed.Value * dt))
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            else
                local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true) 
                            or (targetObj.Parent and targetObj.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                if prompt then fireproximityprompt(prompt, 1, true) end
            end
        else
            -- If it can't find an objective, stop moving so you don't drift away
            removeBV(hrp)
        end
        return 
    end

    -- Manual Movement Logic (Strict CFrame)
    local hoverOn = Toggles.HoverToggle.Value
    local glideOn = Toggles.GlideToggle.Value

    if hoverOn then
        local bv = getOrMakeBV(hrp)
        bv.Velocity = Vector3.zero 
        
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Options.HoverSpeed.Value * dt))
        end
        
        if Toggles.HoverUnderground.Value then 
            hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z) 
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
    elseif glideOn then
        local bv = getOrMakeBV(hrp)
        bv.Velocity = Vector3.zero
        
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Options.GlideSpeed.Value * dt))
        end
        hrp.CFrame = hrp.CFrame + Vector3.new(0, -3 * dt, 0)
        
        if Toggles.GlideUnderground.Value then 
            hrp.CFrame = CFrame.new(hrp.Position.X, 10, hrp.Position.Z) 
        end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        
    else
        removeBV(hrp)
    end
end)

