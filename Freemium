-- Logic to find the nearest objective in the workspace
local function getNearestObjective()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local targetName = Options.ObjectiveName.Value
    local closestDistance = math.huge
    local closestObj = nil

    -- Assuming objectives are stored in Workspace. Look for them dynamically.
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name == targetName and obj:IsA("BasePart") then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < closestDistance then
                closestDistance = dist
                closestObj = obj
            end
        elseif obj.Name == targetName and obj:IsA("Model") and obj.PrimaryPart then
            local dist = (hrp.Position - obj.PrimaryPart.Position).Magnitude
            if dist < closestDistance then
                closestDistance = dist
                closestObj = obj.PrimaryPart
            end
        end
    end
    return closestObj
end

-- AutoFarm Loop Execution
RunService.Heartbeat:Connect(function(dt)
    if not isFarming then return end
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not (hrp and hum) then return end

    -- Disable collisions to prevent getting stuck while autofarming
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end

    currentFarmTarget = getNearestObjective()
    
    if currentFarmTarget then
        local targetPos = currentFarmTarget.Position
        local method = Options.FarmMethod.Value
        
        if method == "Smooth Hover" then
            local bv = getOrMakeBV(hrp)
            local direction = (targetPos - hrp.Position).Unit
            -- Hover exactly 5 studs above the target's Y level to avoid ground friction
            local optimizedTarget = Vector3.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
            local optimizedDirection = (optimizedTarget - hrp.Position).Unit
            
            if (hrp.Position - optimizedTarget).Magnitude > 5 then
                bv.Velocity = optimizedDirection * Options.FarmSpeed.Value
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            else
                bv.Velocity = Vector3.zero
                -- Auto-interact with ProximityPrompts if nearby
                local prompt = currentFarmTarget.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt, 1, true)
                end
            end
            
        elseif method == "Direct Drag (Tween)" then
            local dist = (hrp.Position - targetPos).Magnitude
            local timeToReach = dist / Options.FarmSpeed.Value
            
            local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(hrp, tweenInfo, {CFrame = currentFarmTarget.CFrame + Vector3.new(0, 3, 0)})
            tween:Play()
            
            local prompt = currentFarmTarget.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and dist < 10 then
                fireproximityprompt(prompt, 1, true)
            end
            
        elseif method == "Teleport" then
            hrp.CFrame = currentFarmTarget.CFrame * CFrame.new(0, 3, 0)
            local prompt = currentFarmTarget.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                fireproximityprompt(prompt, 1, true)
            end
        end
    end
end)

