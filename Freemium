--            MOVEMENT LOGIC LOOP
-- ==========================================

-- Noclip loop (Prevents getting stuck or glitching while underground)
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local isHovering = Toggles.HoverToggle and Toggles.HoverToggle.Value
        local isGliding = Toggles.GlideToggle and Toggles.GlideToggle.Value
        local undergroundHover = Toggles.HoverUnderground and Toggles.HoverUnderground.Value
        local undergroundGlide = Toggles.GlideUnderground and Toggles.GlideUnderground.Value

        if (isHovering and undergroundHover) or (isGliding and undergroundGlide) then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- Actual Movement loop (Manipulates HumanoidRootPart directly)
RunService.Heartbeat:Connect(function(dt)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if hrp and hum then
        if Toggles.HoverToggle and Toggles.HoverToggle.Value then
            -- Kill Y-velocity so gravity doesn't pull you down
            hrp.Velocity = Vector3.new(0, 0, 0) 
            
            -- Move based on walk direction (WASD/Joystick)
            if hum.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * Options.HoverSpeed.Value * dt)
            end
            
        elseif Toggles.GlideToggle and Toggles.GlideToggle.Value then
            -- Slight negative Y-velocity to slowly fall
            hrp.Velocity = Vector3.new(0, -5, 0)
            
            -- Move forward
            if hum.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (hum.MoveDirection * Options.GlideSpeed.Value * dt)
            end
        end
    end
end)

