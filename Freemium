-- Function to handle opening the shop UI
local function openShopGUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        -- NOTE: Change "ShopGui" to the exact name of the ScreenGui in Nights of Eternity
        local shop = playerGui:FindFirstChild("ShopGui") or playerGui:FindFirstChild("MainUI")
        if shop and shop:FindFirstChild("ShopFrame", true) then
            local frame = shop:FindFirstChild("ShopFrame", true)
            if not frame.Visible then
                frame.Visible = true
            end
        end
    end
end

-- Continuous Auto-Buy Loop
task.spawn(function()
    while task.wait(2) do -- Check every 2 seconds to avoid rate limits
        local tokens = getCurrentTokens()
        
        -- Process Survivor Auto-Buy
        if Toggles.AutoBuySurvivors and Toggles.AutoBuySurvivors.Value then
            local reqTokens = tonumber(Options.SurvivorCost.Value) or math.huge
            if tokens >= reqTokens then
                openShopGUI()
                task.wait(0.5) -- Give UI time to register
                
                -- NOTE: You must update this RemoteEvent path using Dex. 
                -- Example standard path: ReplicatedStorage.Remotes.BuyItem:FireServer("Survivor", "Name")
