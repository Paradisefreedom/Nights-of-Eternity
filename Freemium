-- Function to shift the player down/up when underground is toggled
local function HandleUndergroundShift(state)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        if state then
            hrp.CFrame = hrp.CFrame * CFrame.new(0, -15, 0) -- Shift 15 studs down
        else
            hrp.CFrame = hrp.CFrame * CFrame.new(0, 15, 0)  -- Shift back up
        end
    end
end

