-- Manual Movement Heartbeat (Only runs if AutoFarm is OFF so they don't conflict)
RunService.Heartbeat:Connect(function(dt)
    if isFarming then return end -- Let AutoFarm handle movement if enabled

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not (hrp and hum) then return end

    local isHovering = Toggles.HoverToggle and Toggles.HoverToggle.Value
    local isGliding = Toggles.GlideToggle and Toggles.GlideToggle.Value

    if isHovering then
        local bv = getOrMakeBV(hrp)
        bv.Velocity = hum.MoveDirection * Options.HoverSpeed.Value
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    elseif isGliding then
        local bv = getOrMakeBV(hrp)
        local moveDir = hum.MoveDirection
        bv.Velocity = Vector3.new(moveDir.X * Options.GlideSpeed.Value, -3, moveDir.Z * Options.GlideSpeed.Value)
        hum:ChangeState(Enum.HumanoidStateType.Physics)
    else
        removeBV(hrp)
    end
end)

-- Noclip logic for manual movement underground
RunService.Stepped:Connect(function()
    if isFarming then return end
    local char = LocalPlayer.Character
    if char then
        local isHovering = Toggles.HoverToggle and Toggles.HoverToggle.Value
        local undergroundHover = Toggles.HoverUnderground and Toggles.HoverUnderground.Value
        if isHovering and undergroundHover then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

