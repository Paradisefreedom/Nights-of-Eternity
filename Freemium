-- Utility to get or create BodyVelocity for smooth hovering/dragging
local function getOrMakeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = bvName
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) 
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
    return bv
end

local function removeBV(hrp)
    local bv = hrp:FindFirstChild(bvName)
    if bv then bv:Destroy() end
end

-- Safely parse numbers from text (handles strings like "1,500" or "2.5k")
local function parseTokens(tokenString)
    if type(tokenString) == "number" then return tokenString end
    local cleanStr = string.gsub(tostring(tokenString), ",", "")
    if string.find(cleanStr:lower(), "k") then
        cleanStr = string.gsub(cleanStr:lower(), "k", "")
        return tonumber(cleanStr) * 1000
    end
    return tonumber(cleanStr) or 0
end

-- Fetch player's current tokens dynamically
local function getCurrentTokens()
    -- 1st Check: Leaderstats (Standard Roblox Architecture)
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local tokensObj = leaderstats:FindFirstChild("Tokens") or leaderstats:FindFirstChild("Coins") or leaderstats:FindFirstChild("Points")
        if tokensObj then
            return tokensObj.Value
        end
    end
    
    -- 2nd Check: PlayerGui (If the game hides it from leaderstats)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        -- NOTE: You will need to update "MainUI.CurrencyFrame.Amount" to match the exact path in Nights of Eternity using Dex Explorer
        local tokenLabel = playerGui:FindFirstChild("MainUI") and playerGui.MainUI:FindFirstChild("CurrencyFrame") and playerGui.MainUI.CurrencyFrame:FindFirstChild("Amount")
        if tokenLabel and tokenLabel:IsA("TextLabel") then
            return parseTokens(tokenLabel.Text)
        end
    end
    
    return 0
end

